{
  "name": "marketpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic real-time financial market simulation, matching engine, and trading terminal",
  "scripts": {
    "dev:backend": "python -m uvicorn marketpulse.api.server:create_app --factory --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "test:backend": "pytest backend/tests",
    "test": "npm run test:backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
